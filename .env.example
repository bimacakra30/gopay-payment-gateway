PORT=3000
API_KEY=YOUR_API_KEY_HERE
QRIS_STATIC=YOUR_QRIS_STATIC_HERE
GOPAY_MERCHANT_ID=YOUR_MERCHANT_ID_HERE # Opsional: Kosongkan jika tidak tahu (akan menggunakan default fallback)
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com # [SEC-02] Domain yang diizinkan CORS
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE # [SEC-04] Kunci enkripsi cookie (opsional, default: API_KEY)
MAX_AMOUNT=10000000 # [SEC-07] Batas maksimum nominal QRIS (default: 10 juta)
